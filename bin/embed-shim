#!/usr/bin/env bash
# skill-concierge — warm embed shim launcher (host / service-free tier).
# Mirrors bin/skill-search-mcp: EXECS the STABLE venv built by setup.sh
# ($HOME/.claude/skill-concierge/venv) so it survives plugin reinstalls.
#
# This shim is retired from the deployed path by ADR-0070 — the local index owner
# (vendor/skill-search/skill_search/index_owner.py) now serves /embed, /health and
# /jev in-process, and nothing starts this shim as a Docker sidecar anymore. This
# launcher stays for standalone use: local dev and the cosine-parity check. It
# runs scripts/embed_server.py, the code index_owner.py was grown from, so parity
# holds against the owner.
set -euo pipefail
VENV="${SKILL_CONCIERGE_VENV:-$HOME/.claude/skill-concierge/venv}"
PY="$VENV/bin/python"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ ! -x "$PY" ]; then
  echo "skill-concierge: engine venv not found at $VENV." >&2
  echo "Run the plugin setup once:  bash \"$here/setup.sh\"" >&2
  exit 127
fi
# The vendored engine is pip-installed into the venv (setup.sh), so skill_search
# imports without PYTHONPATH. Pass the deployed embed env explicitly so the shim
# serves the index's mpnet-768 model, never the engine's bge-small default.
exec env \
  SKILL_EMBED_BACKEND="${SKILL_EMBED_BACKEND:-fastembed}" \
  SKILL_EMBED_MODEL="${SKILL_EMBED_MODEL:-sentence-transformers/paraphrase-multilingual-mpnet-base-v2}" \
  "$PY" "$here/scripts/embed_server.py"
