# telemetry output — compounding runtime data, handled by logman, never committed
logs/
# H1 rationalization harvest sink — verbatim (scrubbed) false-skip SKIPPING clauses, local-only,
# NEVER committed (may quote task text); default under logs/ but pinned explicitly too (ADR-0021)
logs/skill-rationalizations*.txt

# python
__pycache__/
*.pyc

# vendored engine: plugin-local venv + downloaded model cache (reproduced by setup, not committed)
vendor/.venv/
vendor/**/*.egg-info/
# pip build artifact left by `pip install vendor/skill-search` in setup.sh
vendor/**/build/

# os
.DS_Store

# IJFW tool state — internal session tracking (journals, transcripts, metrics, db); not part of the plugin
.ijfw/
ijfw/

# session handoff notes — scratch, not source (see CLAUDE.md)
.handoff/

# generated enrichment artifacts (rebuilt by calibrate_thresholds.py; the utterance
# corpus moved to the operator home ~/.claude/skill-concierge/triggers.json in 0.37.0)
eval/thresholds.json

# generated flywheel eval artifacts (rebuilt by scripts/llm_eval_gen.py / llm_triggers.py)
eval/scenarios-shadow*/
eval/.flywheel-cache.json
eval/triggers.json.bak-*

# python test cache + local env / secrets
.pytest_cache/
.env

# graphify knowledge-graph outputs (rebuilt from source by the graphify skill;
# graph.json/graph.html are derived artifacts, cache/ holds per-file extraction hashes)
graphify-out/

# per-session agent tool state — runtime/token logs, never source. Same class as .ijfw/.
.gjc/

# CommandCode session state — same class as .gjc/ (per-session agent tool state, never source)
.commandcode/

# MemSearch session journals — local memory, and they QUOTE task text (same reason
# logs/skill-rationalizations*.txt is pinned above). Never committed.
.memsearch/

# session/tool scratch — never source, never committed
.codexclaw/
tmp/

# local Claude Code project state — shared plugin config lives in .claude-plugin/, not here.
# EXCEPTION: settings.json is committed on purpose — it wires the openwiki parity guard
# (PreToolUse gate on `git commit`), which is only a gate if it exists on every clone.
# Note the trailing-slash form below would make the negation unreachable, hence `.claude/*`.
.claude/*
!.claude/settings.json

# unlazy gate ledgers/dispatch state (session tooling)
.unlazy/
