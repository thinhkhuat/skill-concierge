{
  "mcpServers": {
    "skill-search": {
      "command": "/bin/bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/skill-search-mcp"
      ],
      "env": {
        "SKILL_QDRANT_URL": "http://localhost:6333",
        "SKILL_EMBED_BACKEND": "ollama",
        "SKILL_EMBED_MODEL": "embeddinggemma-2:270m",
        "SKILL_TOP_K": "6",
        "SKILL_LLM_TRIGGERS": "1",
        "TRIGGERS_MAX": "16",
        "SKILL_TRIGGERS": "${HOME}/.claude/skill-concierge/triggers.json",
        "SKILL_SERVER_RECORDS": "${HOME}/.cache/skill-search/servers",
        "SKILL_DSH_ROOTS": "1",
        "SKILL_CLINE_ROOTS": "1",
        "SKILL_OPENCODE_ROOTS": "1"
      }
    }
  }
}
